  <section class="setting setting--deep" data-reveal>
    <div class="court">
      <div class="setting__head"><h2>Sundays</h2><p>Two services, and a prayer meeting in the week.</p></div>
      
      <ul class="hours" data-church-list="services">
        <template>
          <li class="hour">
            <span class="hour__day" data-item="day">Sunday</span>
